<?xml version="1.0" encoding="utf-8"?>
<!-- 扫描圆环：同心圆 + 中心点 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/neon_green_dim" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/neon_cyan" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:left="48dp"
        android:top="48dp"
        android:right="48dp"
        android:bottom="48dp">
        <shape android:shape="oval">
            <solid android:color="@color/neon_green" />
        </shape>
    </item>
</layer-list>
