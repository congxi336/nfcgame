<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框背景：圆角 + 描边，聚焦时高亮为青绿 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/bg_panel" />
            <corners android:radius="@dimen/corner_md" />
            <stroke
                android:width="1dp"
                android:color="@color/neon_green" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/bg_panel" />
            <corners android:radius="@dimen/corner_md" />
            <stroke
                android:width="1dp"
                android:color="@color/line_dim" />
        </shape>
    </item>
</selector>
