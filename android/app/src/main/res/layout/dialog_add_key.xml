<?xml version="1.0" encoding="utf-8"?>
<!-- 添加密钥对话框 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_key"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/key_input_hint"
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text_primary"
            android:inputType="text"
            android:padding="14dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_random"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_neon"
            android:text="@string/key_random"
            android:textSize="12sp"
            android:textColor="@color/neon_cyan"
            android:textAllCaps="false" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_remark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:hint="@string/key_remark_hint"
        android:textColorHint="@color/text_dim"
        android:textColor="@color/text_primary"
        android:inputType="text"
        android:maxLines="1"
        android:padding="14dp"
        android:textSize="14sp" />
</LinearLayout>
